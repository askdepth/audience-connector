{
  "name": "@askdepth/audience-contract",
  "version": "0.1.0",
  "description": "Wire contract for the Askdepth Audience SDK — zod schemas, signing, version negotiation. Source published; see https://github.com/askdepth/audience-connector.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askdepth/audience-connector.git",
    "directory": "packages/contract"
  },
  "homepage": "https://github.com/askdepth/audience-connector/tree/main/packages/contract#readme",
  "bugs": "https://github.com/askdepth/audience-connector/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
